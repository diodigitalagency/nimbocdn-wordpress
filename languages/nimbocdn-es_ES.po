#. Plugin Name of the plugin
#: nimbocdn.php
#: includes/class-nimbocdn-settings.php:419
#: includes/class-nimbocdn-settings.php:420
#: includes/class-nimbocdn-settings.php:1092
msgid "NimboCDN"
msgstr "NimboCDN"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: nimbocdn.php
msgid "https://nimbocdn.net"
msgstr "https://nimbocdn.net"

#. Description of the plugin
#: nimbocdn.php
msgid "Serves your images resized and in modern formats from our global network, without touching your originals. Deactivate and everything goes back exactly as it was."
msgstr "Entrega tus imágenes redimensionadas y en formatos modernos desde nuestra red global, sin tocar tus originales. Desactívalo y todo vuelve exactamente a como estaba."

#. Author of the plugin
#: nimbocdn.php
msgid "DIO Digital"
msgstr "DIO Digital"

#: includes/class-nimbocdn-settings.php:116
msgid "NimboCDN: we could not charge your card"
msgstr "NimboCDN: no pudimos cobrar tu tarjeta"

#. translators: %s: number of days remaining
#: includes/class-nimbocdn-settings.php:121
#, php-format
msgid "You have %s day to update your payment method before this site returns to the free plan."
msgid_plural "You have %s days to update your payment method before this site returns to the free plan."
msgstr[0] "Tienes %s día para actualizar tu medio de pago antes de que este sitio vuelva al plan gratuito."
msgstr[1] "Tienes %s días para actualizar tu medio de pago antes de que este sitio vuelva al plan gratuito."

#: includes/class-nimbocdn-settings.php:125
msgid "Update your payment method today to keep this site on Pro."
msgstr "Actualiza tu medio de pago hoy para mantener este sitio en Pro."

#: includes/class-nimbocdn-settings.php:128
msgid "Review it now"
msgstr "Revisarlo ahora"

#: includes/class-nimbocdn-settings.php:209
#: includes/class-nimbocdn-settings.php:2138
msgid "Measuring…"
msgstr "Midiendo…"

#. translators: %s: seconds
#: includes/class-nimbocdn-settings.php:211
#: includes/class-nimbocdn-settings.php:2830
#, php-format
msgid "Wait %ss"
msgstr "Espera %ss"

#. translators: 1: data center city, 2: milliseconds, for example "9 ms"
#: includes/class-nimbocdn-settings.php:214
#, php-format
msgid "Right now, this computer receives your images from %1$s, in %2$s."
msgstr "Ahora mismo, esta computadora recibe tus imágenes desde %1$s, en %2$s."

#. translators: 1: data center city, 2: milliseconds, for example "9 ms"
#: includes/class-nimbocdn-settings.php:217
#, php-format
msgid "Optimization paused. This computer is answered from %1$s, %2$s away — resume and your images are delivered from there."
msgstr "Optimización en pausa. A esta computadora le responde %1$s, a %2$s — reanuda y tus imágenes se entregan desde ahí."

#. translators: %s: data center city
#: includes/class-nimbocdn-settings.php:222
#, php-format
msgid "Right now, this computer receives your images from %s."
msgstr "Ahora mismo, esta computadora recibe tus imágenes desde %s."

#. translators: %s: data center city
#: includes/class-nimbocdn-settings.php:224
#, php-format
msgid "Optimization paused. This computer is answered from %s — resume and your images are delivered from there."
msgstr "Optimización en pausa. A esta computadora le responde %s — reanuda y tus imágenes se entregan desde ahí."

#. translators: %s: number of milliseconds
#: includes/class-nimbocdn-settings.php:232
#, php-format
msgid "%s ms"
msgstr "%s ms"

#: includes/class-nimbocdn-settings.php:233
#: includes/class-nimbocdn-settings.php:2833
msgctxt "button: measure again now"
msgid "Measure now"
msgstr "Medir ahora"

#: includes/class-nimbocdn-settings.php:234
msgid "Could not measure right now. Your images keep working; try again in a moment."
msgstr "No se pudo medir ahora. Tus imágenes siguen funcionando; vuelve a intentar en un momento."

#. translators: %s: formatted price, for example "R$ 49,90"
#: includes/class-nimbocdn-settings.php:240
#, php-format
msgid "Get Pro — %s/month"
msgstr "Contratar Pro — %s/mes"

#: includes/class-nimbocdn-settings.php:474
msgid "You are not allowed to do this."
msgstr "No tienes permiso para hacer esto."

#: includes/class-nimbocdn-settings.php:552
msgid "Settings"
msgstr "Ajustes"

#: includes/class-nimbocdn-settings.php:566
msgid "Support"
msgstr "Soporte"

#. translators: %s: this site's domain
#: includes/class-nimbocdn-settings.php:581
#, php-format
msgid "A question about the NimboCDN plugin on %s (WordPress)"
msgstr "Una consulta sobre el plugin NimboCDN en %s (WordPress)"

#: includes/class-nimbocdn-settings.php:973
msgid "Domain not verified yet."
msgstr "El dominio todavía no está verificado."

#: includes/class-nimbocdn-settings.php:974
msgid "Your images are being optimized on the free plan all the same. Upgrading to Pro and managing billing stay locked until the service can confirm this site is yours: it tries to read a small verification file from this site over the internet, and so far it could not."
msgstr "Tus imágenes se están optimizando igual, en el plan gratuito. Contratar Pro y gestionar el cobro quedan cerrados hasta que el servicio pueda confirmar que este sitio es tuyo: intenta leer un pequeño archivo de verificación desde este sitio por internet, y hasta ahora no pudo."

#. translators: 1: URL pattern of the verification file, 2: URL of the verification route
#: includes/class-nimbocdn-settings.php:977
#, php-format
msgid "If this site runs behind a firewall or a security plugin, allow requests from the user agent NimboCDN-Verify to %1$s (or to %2$s), then press Measure now. It is retried automatically twice a day."
msgstr "Si este sitio está detrás de un firewall o un plugin de seguridad, permite las peticiones del agente NimboCDN-Verify a %1$s (o a %2$s) y luego presiona Medir ahora. Se reintenta solo dos veces por día."

#: includes/class-nimbocdn-settings.php:1000
msgid "Measured. The result is below."
msgstr "Medido. El resultado está abajo."

#: includes/class-nimbocdn-settings.php:1001
msgid "Measured less than a minute ago. Visitor data takes up to a minute to arrive — try again shortly."
msgstr "Medido hace menos de un minuto. Los datos de visitantes tardan hasta un minuto en llegar — vuelve a intentar en un rato."

#: includes/class-nimbocdn-settings.php:1002
msgid "This site is on the free plan. Upgrade to manage a subscription."
msgstr "Este sitio está en el plan gratuito. Contrata Pro para gestionar una suscripción."

#: includes/class-nimbocdn-settings.php:1013
msgid "Your Pro plan was activated directly by our team, so there is no online subscription to manage. For any change, write to hello@nimbocdn.net."
msgstr "Tu plan Pro lo activó directamente nuestro equipo, así que no hay ninguna suscripción en línea que gestionar. Para cualquier cambio, escribe a hello@nimbocdn.net."

#: includes/class-nimbocdn-settings.php:1014
msgid "Could not reach the billing service. Your images keep working; try again in a moment."
msgstr "No se pudo contactar al servicio de cobro. Tus imágenes siguen funcionando; vuelve a intentar en un momento."

#: includes/class-nimbocdn-settings.php:1015
msgid "Could not open the subscription portal. Your images keep working; try again in a moment."
msgstr "No se pudo abrir el portal de suscripción. Tus imágenes siguen funcionando; vuelve a intentar en un momento."

#: includes/class-nimbocdn-settings.php:1016
msgid "Billing email updated."
msgstr "Correo de cobro actualizado."

#: includes/class-nimbocdn-settings.php:1017
msgid "That does not look like an email address."
msgstr "Eso no parece una dirección de correo."

#: includes/class-nimbocdn-settings.php:1018
msgid "Could not reach the service. The email was not changed — try again in a moment."
msgstr "No se pudo contactar al servicio. El correo no se cambió — vuelve a intentar en un momento."

#: includes/class-nimbocdn-settings.php:1021
msgid "Saved, but the billing provider could not be updated. Please try again so payment notices reach the new address."
msgstr "Guardado, pero no se pudo actualizar el proveedor de cobro. Vuelve a intentar para que los avisos de pago lleguen a la dirección nueva."

#: includes/class-nimbocdn-settings.php:1022
msgid "Account updated."
msgstr "Cuenta actualizada."

#: includes/class-nimbocdn-settings.php:1023
msgid "Nothing to save — neither field changed."
msgstr "No hay nada que guardar — ninguno de los dos campos cambió."

#: includes/class-nimbocdn-settings.php:1026
msgid "Billing email saved, but your email preference was not. Try that one again."
msgstr "Se guardó el correo de cobro, pero no tu preferencia de correo. Vuelve a intentar con esa."

#: includes/class-nimbocdn-settings.php:1027
msgid "Email preference saved, but the billing email was not. Try that one again."
msgstr "Se guardó tu preferencia de correo, pero no el correo de cobro. Vuelve a intentar con ese."

#: includes/class-nimbocdn-settings.php:1028
msgid "You will get occasional emails about NimboCDN."
msgstr "Vas a recibir correos ocasionales sobre NimboCDN."

#: includes/class-nimbocdn-settings.php:1031
msgid "No more product emails. Payment notices still arrive — they are part of the service."
msgstr "Listo, no más correos sobre el producto. Los avisos de pago siguen llegando — son parte del servicio."

#: includes/class-nimbocdn-settings.php:1032
msgid "Could not reach the service. Your email preference was not changed — try again in a moment."
msgstr "No se pudo contactar al servicio. Tu preferencia de correo no cambió — vuelve a intentar en un momento."

#: includes/class-nimbocdn-settings.php:1035
msgid "Payment received — welcome to Pro. Your whole library is being optimized from now on; the change can take a couple of minutes to reach every data center."
msgstr "Pago recibido — bienvenido a Pro. Desde ahora se optimiza toda tu biblioteca; el cambio puede tardar un par de minutos en llegar a todos los centros de datos."

#: includes/class-nimbocdn-settings.php:1036
msgid "Checkout could not be opened. Nothing was charged; your images keep working. Try again in a moment."
msgstr "No se pudo abrir el pago. No se cobró nada; tus imágenes siguen funcionando. Vuelve a intentar en un momento."

#: includes/class-nimbocdn-settings.php:1041
msgid "Optimization paused. Your site keeps working — WordPress serves the images, exactly as it did before NimboCDN."
msgstr "Optimización en pausa. Tu sitio sigue funcionando — WordPress entrega las imágenes, exactamente como antes de NimboCDN."

#: includes/class-nimbocdn-settings.php:1042
msgid "Optimization resumed. Your images are again delivered to each visitor in the best size and format their device supports — lighter pages, faster experience."
msgstr "Optimización reanudada. Tus imágenes vuelven a entregarse a cada visitante en el mejor tamaño y formato que soporta su dispositivo — páginas más livianas, experiencia más rápida."

#: includes/class-nimbocdn-settings.php:1107
#: includes/class-nimbocdn-settings.php:1108
msgid "Open nimbocdn.net in a new tab"
msgstr "Abrir nimbocdn.net en una pestaña nueva"

#: includes/class-nimbocdn-settings.php:1151
msgid "NimboCDN never modifies your original files. Deactivate the plugin and your site returns to exactly how it was."
msgstr "NimboCDN nunca modifica tus archivos originales. Desactiva el plugin y tu sitio vuelve exactamente a como estaba."

#: includes/class-nimbocdn-settings.php:1201
msgid "Your visitors"
msgstr "Tus visitantes"

#: includes/class-nimbocdn-settings.php:1216
msgid "Resume"
msgstr "Reanudar"

#: includes/class-nimbocdn-settings.php:1216
msgid "Pause"
msgstr "Pausar"

#: includes/class-nimbocdn-settings.php:1236
msgid "Your home page"
msgstr "Tu página de inicio"

#: includes/class-nimbocdn-settings.php:1240
msgid "— paused"
msgstr "— en pausa"

#: includes/class-nimbocdn-settings.php:1251
msgid "Your plan"
msgstr "Tu plan"

#: includes/class-nimbocdn-settings.php:1253
msgid "Pro plan"
msgstr "Plan Pro"

#: includes/class-nimbocdn-settings.php:1255
msgid "Free plan"
msgstr "Plan gratuito"

#: includes/class-nimbocdn-settings.php:1266
msgid "We could not charge your card"
msgstr "No pudimos cobrar tu tarjeta"

#. translators: %s: number of days remaining
#: includes/class-nimbocdn-settings.php:1272
#, php-format
msgid "Update your payment method within %s day to keep Pro. Your images keep being delivered optimized in the meantime."
msgid_plural "Update your payment method within %s days to keep Pro. Your images keep being delivered optimized in the meantime."
msgstr[0] "Actualiza tu medio de pago dentro de %s día para mantener Pro. Mientras tanto, tus imágenes se siguen entregando optimizadas."
msgstr[1] "Actualiza tu medio de pago dentro de %s días para mantener Pro. Mientras tanto, tus imágenes se siguen entregando optimizadas."

#: includes/class-nimbocdn-settings.php:1276
msgid "Update your payment method today to keep Pro. Your images keep being delivered optimized in the meantime."
msgstr "Actualiza tu medio de pago hoy para mantener Pro. Mientras tanto, tus imágenes se siguen entregando optimizadas."

#: includes/class-nimbocdn-settings.php:1280
msgid "Update payment method"
msgstr "Actualizar medio de pago"

#. translators: %s: percentage, for example "88%"
#: includes/class-nimbocdn-settings.php:1314
#, php-format
msgid "Home page %s lighter · measured"
msgstr "Página de inicio %s más liviana · medido"

#: includes/class-nimbocdn-settings.php:1317
msgid "Measured on the first visit to your home page."
msgstr "Medido en la primera visita a tu página de inicio."

#. translators: %s: percentage, for example "91%"
#: includes/class-nimbocdn-settings.php:1331
#, php-format
msgid "%s of your images are served from our cache, not from your server."
msgstr "El %s de tus imágenes se sirve desde nuestro caché, no desde tu servidor."

#: includes/class-nimbocdn-settings.php:1334
msgid "Each image leaves your server once; after that, our cache serves it."
msgstr "Cada imagen sale de tu servidor una vez; después la sirve nuestro caché."

#: includes/class-nimbocdn-settings.php:1341
msgid "Why NimboCDN"
msgstr "Por qué NimboCDN"

#: includes/class-nimbocdn-settings.php:1344
msgid "Every visitor gets smaller images, in the best format their browser accepts, delivered by our global network. Your WordPress stays exactly as it is."
msgstr "Cada visitante recibe imágenes más chicas, en el mejor formato que acepta su navegador, entregadas por nuestra red global. Tu WordPress queda exactamente igual."

#: includes/class-nimbocdn-settings.php:1349
msgid "Faster site"
msgstr "Sitio más rápido"

#: includes/class-nimbocdn-settings.php:1353
msgid "Lighter server"
msgstr "Servidor más liviano"

#: includes/class-nimbocdn-settings.php:1404
msgid "Pro active · your whole site optimized"
msgstr "Pro activo · todo tu sitio optimizado"

#: includes/class-nimbocdn-settings.php:1409
msgid "Free"
msgstr "Gratuito"

#: includes/class-nimbocdn-settings.php:1409
msgid "Your home page optimized, for good"
msgstr "Tu página de inicio optimizada, para siempre"

#: includes/class-nimbocdn-settings.php:1410
msgid "Pro"
msgstr "Pro"

#. translators: %s: number of images
#: includes/class-nimbocdn-settings.php:1441
#: includes/class-nimbocdn-settings.php:3227
#, php-format
msgid "%s image outside your home page still reaches your visitors heavy."
msgid_plural "%s images outside your home page still reach your visitors heavy."
msgstr[0] "%s imagen fuera de tu página de inicio todavía llega pesada a tus visitantes."
msgstr[1] "%s imágenes fuera de tu página de inicio todavía llegan pesadas a tus visitantes."

#: includes/class-nimbocdn-settings.php:1445
msgid "With Pro, all of them would be optimized."
msgstr "Con Pro, todas estarían optimizadas."

#: includes/class-nimbocdn-settings.php:1451
msgid "See Pro ↓"
msgstr "Ver Pro ↓"

#: includes/class-nimbocdn-settings.php:1551
msgid "Our global network"
msgstr "Nuestra red global"

#: includes/class-nimbocdn-settings.php:1554
msgid "World map with our data centers and the one serving this computer"
msgstr "Mapa del mundo con nuestros centros de datos y el que atiende a esta computadora"

#: includes/class-nimbocdn-settings.php:1562
msgid "Finding where your images are delivered from…"
msgstr "Localizando desde dónde se entregan tus imágenes…"

#. translators: 1: number of cities, 2: number of countries
#: includes/class-nimbocdn-settings.php:1568
#, php-format
msgid "%1$s cities in more than %2$s countries deliver your images."
msgstr "%1$s ciudades en más de %2$s países entregan tus imágenes."

#: includes/class-nimbocdn-settings.php:1574
msgid "Approximate location from the IP address of this computer. Nothing is stored: it is shown and discarded."
msgstr "Ubicación aproximada a partir de la dirección IP de esta computadora. No se guarda nada: se muestra y se descarta."

#: includes/class-nimbocdn-settings.php:1589
msgid "Talk to us"
msgstr "Habla con nosotros"

#: includes/class-nimbocdn-settings.php:1592
msgid "A question, a problem, an idea — write and a person answers."
msgstr "Una duda, un problema, una idea — escribe y te responde una persona."

#. translators: %s: the "Settings → NimboCDN" menu path, linked to this screen
#: includes/class-nimbocdn-settings.php:1603
#, php-format
msgid "This screen always lives under %s."
msgstr "Esta pantalla está siempre en %s."

#: includes/class-nimbocdn-settings.php:1604
msgid "Settings → NimboCDN"
msgstr "Ajustes → NimboCDN"

#: includes/class-nimbocdn-settings.php:2135
msgid "Optimization paused"
msgstr "Optimización en pausa"

#: includes/class-nimbocdn-settings.php:2141
msgid "Delivering optimized images"
msgstr "Entregando imágenes optimizadas"

#: includes/class-nimbocdn-settings.php:2144
msgid "New images not optimized"
msgstr "Imágenes nuevas sin optimizar"

#: includes/class-nimbocdn-settings.php:2149
msgid "Could not measure"
msgstr "No se pudo medir"

#: includes/class-nimbocdn-settings.php:2152
msgid "Not measured yet"
msgstr "Todavía sin medir"

#: includes/class-nimbocdn-settings.php:2207
msgid "In the last 30 days your visitors received each image"
msgstr "En los últimos 30 días, tus visitantes recibieron cada imagen"

#. translators: %s: amount of data, for example "1.8 GB"
#: includes/class-nimbocdn-settings.php:2221
#, php-format
msgid "That is %s they did not have to download"
msgstr "Son %s que no tuvieron que descargar"

#: includes/class-nimbocdn-settings.php:2228
msgid "of images — no saving measured yet against what WordPress would have served."
msgstr "de imágenes — todavía sin ahorro medido contra lo que WordPress habría entregado."

#. translators: %s: amount of data, for example "12.4 GB"
#: includes/class-nimbocdn-settings.php:2234
#, php-format
msgid "Since you installed NimboCDN: %s less."
msgstr "Desde que instalaste NimboCDN: %s menos."

#: includes/class-nimbocdn-settings.php:2262
msgid "Measuring your home page…"
msgstr "Midiendo tu página de inicio…"

#: includes/class-nimbocdn-settings.php:2291
msgid "Each image on your home page is now"
msgstr "Cada imagen de tu página de inicio ahora es"

#: includes/class-nimbocdn-settings.php:2301
msgid "As soon as the first visits arrive, this number updates with them."
msgstr "En cuanto lleguen las primeras visitas, este número se actualiza con ellas."

#: includes/class-nimbocdn-settings.php:2331
msgid "This is running in the background and can take up to a minute. This screen refreshes on its own — nothing to press."
msgstr "Esto corre en segundo plano y puede tardar hasta un minuto. Esta pantalla se actualiza sola — no hay nada que presionar."

#: includes/class-nimbocdn-settings.php:2346
msgid "Step 1 of 4 — connecting this site to the service."
msgstr "Paso 1 de 4 — conectando este sitio con el servicio."

#: includes/class-nimbocdn-settings.php:2349
msgid "Step 1 of 4 — reading your home page and finding its images."
msgstr "Paso 1 de 4 — leyendo tu página de inicio y encontrando sus imágenes."

#. translators: %s: number of images
#: includes/class-nimbocdn-settings.php:2353
#, php-format
msgid "Step 2 of 4 — registering %s images with the service."
msgstr "Paso 2 de 4 — registrando %s imágenes en el servicio."

#: includes/class-nimbocdn-settings.php:2356
msgid "Step 2 of 4 — reading the home page again, now optimized."
msgstr "Paso 2 de 4 — leyendo la página de inicio otra vez, ya optimizada."

#. translators: 1: images weighed so far, 2: images to weigh
#: includes/class-nimbocdn-settings.php:2360
#, php-format
msgid "Step 3 of 4 — weighing the images: %1$s of %2$s."
msgstr "Paso 3 de 4 — pesando las imágenes: %1$s de %2$s."

#. translators: 1: images weighed so far, 2: images to weigh, 3: attempt number, 4: attempts
#: includes/class-nimbocdn-settings.php:2364
#, php-format
msgid "Step 3 of 4 — %1$s of %2$s weighed; waiting for the network to learn the new list (attempt %3$s of %4$s)."
msgstr "Paso 3 de 4 — %1$s de %2$s pesadas; esperando a que la red aprenda la lista nueva (intento %3$s de %4$s)."

#. translators: 1: images weighed so far, 2: images to weigh
#: includes/class-nimbocdn-settings.php:2368
#, php-format
msgid "Step 3 of 4 — %1$s of %2$s weighed; one more try for the rest."
msgstr "Paso 3 de 4 — %1$s de %2$s pesadas; un intento más para el resto."

#: includes/class-nimbocdn-settings.php:2371
msgid "Step 4 of 4 — second pass, from the cache, to measure the response time."
msgstr "Paso 4 de 4 — segunda pasada, desde el caché, para medir el tiempo de respuesta."

#: includes/class-nimbocdn-settings.php:2374
msgid "Starting…"
msgstr "Comenzando…"

#: includes/class-nimbocdn-settings.php:2431
msgid "images delivered"
msgstr "imágenes entregadas"

#: includes/class-nimbocdn-settings.php:2433
msgid "Images delivered by NimboCDN in the latest measurement of your home page. Visitor traffic takes over as it arrives."
msgstr "Imágenes entregadas por NimboCDN en la última medición de tu página de inicio. El tráfico de visitantes toma el relevo a medida que llega."

#: includes/class-nimbocdn-settings.php:2434
msgid "Images NimboCDN delivered to your visitors in the last 30 days."
msgstr "Imágenes que NimboCDN entregó a tus visitantes en los últimos 30 días."

#: includes/class-nimbocdn-settings.php:2441
msgid "delivered by our network"
msgstr "entregadas por nuestra red"

#: includes/class-nimbocdn-settings.php:2443
msgid "What NimboCDN delivered while weighing your home page. Visitor traffic takes over as it arrives."
msgstr "Lo que NimboCDN entregó mientras pesaba tu página de inicio. El tráfico de visitantes toma el relevo a medida que llega."

#: includes/class-nimbocdn-settings.php:2444
msgid "Everything NimboCDN sent to your visitors in the last 30 days. Your own server did not have to send any of it."
msgstr "Todo lo que NimboCDN envió a tus visitantes en los últimos 30 días. Tu propio servidor no tuvo que enviar nada de eso."

#: includes/class-nimbocdn-settings.php:2452
msgid "without touching your server"
msgstr "sin tocar tu servidor"

#: includes/class-nimbocdn-settings.php:2455
msgid "Shown once enough images have been delivered: on the first day almost everything is a first request."
msgstr "Se muestra cuando se entregaron suficientes imágenes: el primer día casi todo es una primera petición."

#: includes/class-nimbocdn-settings.php:2474
msgid "network response time"
msgstr "tiempo de respuesta de la red"

#: includes/class-nimbocdn-settings.php:2534
msgid "Format your visitors received"
msgstr "Formato que recibieron tus visitantes"

#. translators: 1: format name, 2: number of images, 3: percentage
#: includes/class-nimbocdn-settings.php:2544
#, php-format
msgid "%1$s: %2$s images (%3$s)"
msgstr "%1$s: %2$s imágenes (%3$s)"

#. translators: 1: date, 2: amount of data, for example "1.8 MB"
#: includes/class-nimbocdn-settings.php:2595
#, php-format
msgid "%1$s: %2$s less"
msgstr "%1$s: %2$s menos"

#. translators: %s: date
#: includes/class-nimbocdn-settings.php:2597
#, php-format
msgid "%s: no saving recorded"
msgstr "%s: sin ahorro registrado"

#: includes/class-nimbocdn-settings.php:2618
msgid "Last 30 days — fills in with the first visits"
msgstr "Últimos 30 días — se completa con las primeras visitas"

